{
 "vsl-trade": {
  "local": "sites/vsl-trade",
  "sessionStorage": {
   "vsl-intro": "1"
  },
  "localStorage": {
   "vsl-intro": "1"
  },
  "hide": [
   "#vsl-intro",
   "#google_translate_element",
   ".skiptranslate"
  ],
  "css": "body{top:0!important}",
  "clips": [
   {
    "name": "film-tour",
    "viewport": "desktop",
    "path": "index.html",
    "steps": [
     {
      "mark": "One supplier, the whole shop",
      "wait": 1400
     },
     {
      "mark": "Two ranges, one account",
      "scrollTo": ".ce-cats",
      "ms": 1500,
      "offset": 150
     },
     {
      "hover": ".ce-cat-b",
      "ms": 600,
      "after": 400
     },
     {
      "tap": ".ce-cat-a",
      "ms": 600,
      "navWait": 1500,
      "after": 700
     },
     {
      "mark": "Every vape category",
      "scrollTo": ".vn-sqgrid",
      "ms": 1200,
      "offset": 150
     },
     {
      "hover": ".vn-sq",
      "nth": 1,
      "ms": 600,
      "after": 300
     },
     {
      "mark": "The brands they ask for",
      "scrollTo": ".vn-brands",
      "ms": 1100,
      "offset": 170
     },
     {
      "hover": ".vn-brands-tiles img",
      "nth": 7,
      "ms": 600,
      "after": 500
     },
     {
      "mark": "The App, from the till",
      "tap": ".nav-links a",
      "text": "The App",
      "ms": 800,
      "navWait": 1500,
      "after": 700
     },
     {
      "scroll": 520,
      "ms": 1200
     },
     {
      "wait": 300
     },
     {
      "mark": "Register in a minute",
      "tap": ".nav-right .btn-primary",
      "ms": 800,
      "navWait": 1500,
      "after": 400
     },
     {
      "scrollTo": "#store-name",
      "ms": 900,
      "offset": 300
     },
     {
      "type": [
       "#store-name",
       "Sam's Shop"
      ],
      "ms": 500,
      "after": 900
     }
    ],
    "tail": 600,
    "lead": 600
   }
  ]
 }
}