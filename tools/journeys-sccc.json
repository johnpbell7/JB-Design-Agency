      "cut": 1800,
      "after": 500
     },
     {
      "scrollTo": "a[href='/decades/1910']",
      "ms": 1100,
      "offset": 420
     },
     {
      "hover": "a[href='/decades/1910']",
      "ms": 700,
      "after": 800
     },
     {
      "mark": "Inside a decade",
      "tap": "a[href='/decades/1910']",
