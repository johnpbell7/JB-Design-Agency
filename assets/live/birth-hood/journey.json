{
  "name": "birth-hood",
  "viewport": { "width": 1440, "height": 900 },
  "pace": 1.1,
  "start": [1060, 640],
  "startOffset": 100,
  "cursor": { "size": 22 },
  "css": ".mobile-book-fab{transition:none}",
  "escapeOnJump": true,
  "closeOnJump": [".quiz-modal-close"],
  "steps": [
    {
      "label": "The menu",
      "page": "index.html",
      "start": 0,
      "actions": [
        { "hover": ".nav-dropdown > a", "nth": 0, "ms": 900, "after": 900 },
        { "hover": ".nav-drop-menu a", "nth": 0, "ms": 500, "after": 300 },
        { "hover": ".nav-drop-menu a", "nth": 1, "ms": 400, "after": 500 },
        { "hover": ".nav-dropdown > a", "nth": 1, "ms": 600, "after": 900 },
        { "hover": ".nav-drop-menu a", "nth": 0, "ms": 500, "after": 700 },
        { "move": [980, 420], "ms": 1100, "after": 1600 }
      ]
    },
    {
      "label": "The services",
      "page": "index.html",
      "start": { "to": ".services", "offset": 0 },
      "actions": [
        { "hover": ".service-cell", "nth": 0, "at": [0.5, 0.45], "ms": 800, "after": 800 },
        { "hover": ".service-cell", "nth": 1, "at": [0.5, 0.45], "ms": 600, "after": 800 },
        { "hover": ".service-cell", "nth": 2, "at": [0.5, 0.45], "ms": 600, "after": 800 },
        { "hover": ".service-cell", "nth": 3, "at": [0.5, 0.45], "ms": 600, "after": 1200 }
      ]
    },
    {
      "label": "What clients say",
      "page": "index.html",
      "start": { "to": ".testimonials", "offset": 0 },
      "actions": [
        { "hover": ".review-card", "nth": 0, "ms": 800, "after": 1000 },
        { "hover": ".review-card", "nth": 1, "ms": 600, "after": 1000 },
        { "hover": ".review-card", "nth": 2, "ms": 600, "after": 1300 }
      ]
    },
    {
      "label": "Finding a package",
      "page": "find-your-package.html",
      "start": { "to": ".quiz", "offset": 140 },
      "actions": [
        { "click": ".quiz-option", "nth": 0, "ms": 800, "after": 700 },
        { "click": ".quiz-option", "nth": 2, "ms": 600, "after": 700 },
        { "click": ".quiz-option", "nth": 1, "ms": 600, "after": 700 },
        { "click": ".quiz-option", "nth": 2, "ms": 600, "after": 700 },
        { "click": ".quiz-option", "nth": 1, "ms": 600, "after": 1400 },
        { "hover": ".quiz-result-list", "ms": 900, "after": 1800 }
      ]
    }
  ],
  "mobile": {
    "label": "Birth doula",
    "page": "index.html",
    "width": 390,
    "touch": true,
    "start": 0,
    "actions": [
      { "wait": 1400 },
      { "tap": ".nav-ham", "after": 1000 },
      { "tap": ".mob-accordion", "text": "Doula", "after": 900 },
      { "tap": ".mob-menu a", "text": "Birth Doula", "after": 300 },
      { "wait": 1200 },
      { "scroll": 700, "ms": 2300, "after": 900 },
      { "scroll": 800, "ms": 2400, "after": 1200 }
    ]
  }
}
