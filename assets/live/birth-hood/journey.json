{
  "name": "birth-hood",
  "viewport": { "width": 1440, "height": 900 },
  "pace": 1.1,
  "start": [1060, 640],
  "startOffset": 100,
  "cursor": { "size": 22 },
  "css": ".mobile-book-fab{transition:none}",
  "escapeOnJump": true,
  "closeOnJump": [".quiz-modal-close"],
  "steps": [
    {
      "label": "The home page",
      "page": "index.html",
      "start": 0,
      "actions": [
        { "wait": 900 },
        { "move": ".home-hero-split h1", "ms": 1100, "after": 900 },
        { "scroll": 520, "ms": 2600, "after": 1200 },
        { "move": [980, 420], "ms": 900, "after": 900 }
      ]
    },
    {
      "label": "Every service in the menu",
      "page": "index.html",
      "start": 0,
      "actions": [
        { "hover": ".nav-dropdown > a", "nth": 0, "ms": 900, "after": 900 },
        { "hover": ".nav-drop-menu a", "nth": 1, "ms": 500, "after": 500 },
        { "hover": ".nav-dropdown > a", "nth": 1, "ms": 600, "after": 900 },
        { "hover": ".nav-drop-menu a", "nth": 0, "ms": 500, "after": 600 },
        { "hover": ".nav-dropdown > a", "nth": 2, "ms": 600, "after": 900 },
        { "hover": ".nav-drop-menu a", "nth": 2, "ms": 500, "after": 900 }
      ]
    },
    {
      "label": "The Birth Doula page",
      "page": "index.html",
      "start": 0,
      "actions": [
        { "hover": ".nav-dropdown > a", "nth": 0, "ms": 900, "after": 700 },
        { "click": ".nav-drop-menu a", "text": "Birth Doula", "ms": 600, "after": 300 },
        { "wait": 1400 },
        { "scroll": 640, "ms": 2600, "after": 1000 },
        { "scroll": 760, "ms": 2600, "after": 1200 }
      ]
    },
    {
      "label": "Three clear packages",
      "page": "birth-doula.html",
      "start": { "to": ".price-card", "offset": 130 },
      "actions": [
        { "hover": ".price-card", "nth": 0, "at": [0.5, 0.25], "ms": 900, "after": 1000 },
        { "hover": ".price-card", "nth": 1, "at": [0.5, 0.25], "ms": 700, "after": 1300 },
        { "hover": ".price-card", "nth": 2, "at": [0.5, 0.25], "ms": 700, "after": 1300 }
      ]
    },
    {
      "label": "Five quick questions",
      "page": "birth-doula.html",
      "start": { "to": ".price-card", "offset": 330 },
      "actions": [
        { "click": "button.btn-primary", "text": "Find your package", "ms": 900, "after": 1000 },
        { "click": ".quiz-option", "nth": 0, "ms": 800, "after": 700 },
        { "click": ".quiz-option", "nth": 3, "ms": 600, "after": 700 },
        { "click": ".quiz-option", "nth": 3, "ms": 600, "after": 700 },
        { "click": ".quiz-option", "nth": 3, "ms": 600, "after": 700 },
        { "click": ".quiz-option", "nth": 2, "ms": 600, "after": 1200 }
      ]
    },
    {
      "label": "The best match, then a free call",
      "page": "birth-doula.html?finder=0,3,3,3,2",
      "start": 0,
      "actions": [
        { "hover": ".quiz-result-price", "ms": 900, "after": 1000 },
        { "hover": ".quiz-result-list li", "nth": 3, "ms": 800, "after": 1000 },
        { "click": ".quiz-result .btn-primary", "ms": 800, "after": 1800 }
      ]
    }
  ],
  "mobile": {
    "label": "Birth doula",
    "page": "index.html",
    "width": 390,
    "touch": true,
    "start": 0,
    "actions": [
      { "wait": 1400 },
      { "tap": ".nav-ham", "after": 1000 },
      { "tap": ".mob-accordion", "text": "Doula", "after": 900 },
      { "tap": ".mob-menu a", "text": "Birth Doula", "after": 300 },
      { "wait": 1200 },
      { "scroll": 700, "ms": 2300, "after": 900 },
      { "scroll": 800, "ms": 2400, "after": 1200 }
    ]
  }
}
