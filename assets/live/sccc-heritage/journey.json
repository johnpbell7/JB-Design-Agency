  "size": 22
 },
 "css": "a[href^=\"mailto:\"],a[href^=\"tel:\"]{display:none!important} .md\\:grid-cols-2>div{position:relative;transition:transform .35s cubic-bezier(.2,.8,.3,1),box-shadow .35s} .md\\:grid-cols-2>div.lv-hover,.md\\:grid-cols-2>div:has(.lv-hover){transform:translateY(-6px) scale(1.035);box-shadow:0 20px 34px -14px rgba(139,21,56,.5);z-index:2}",
