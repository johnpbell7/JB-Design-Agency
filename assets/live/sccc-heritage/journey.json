  {
   "label": "Bowl to scroll",
   "page": "index.html?p=/",
   "start": 0,
   "reload": true,
   "actions": [
    {
     "wait": 900
    },
    {
     "tap": "section.relative.h-screen img.rounded-full",
     "ms": 1200,
     "after": 2200
    },
    {
     "scroll": 900,
     "ms": 2000,
     "after": 900
    },
    {
     "scrollTo": "a[href='?p=/decades']",
     "offset": 520,
     "ms": 1400,
     "after": 600
    },
    {
     "click": "a[href='?p=/decades']",
     "text": "View All",
     "ms": 1000,
     "after": 300
    }
   ]
  },
  {
