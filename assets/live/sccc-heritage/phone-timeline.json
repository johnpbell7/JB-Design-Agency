{
  "name": "SCCC Heritage: Timeline",
  "mobile": {
    "label": "Timeline",
    "page": "index.html?p=/journey",
    "width": 390,
    "touch": true,
    "start": {
      "to": "button.block.text-left",
      "offset": 140
    },
    "actions": [
      { "wait": 1000 },
      { "slide": "input[type=range]", "to": 1900, "ms": 3200, "after": 900 },
      { "slide": "input[type=range]", "to": 1850, "ms": 1800, "after": 900 },
      { "tap": "button.block.text-left", "nth": 2, "after": 2400 },
      { "tap": "button", "text": "next", "after": 2400 },
      { "tap": "button[aria-label='Close']", "after": 1200 }
    ]
  }
}
