{
  "name": "Nic Pouches",
  "viewport": {"width": 1440, "height": 900},
  "pace": 1,
  "start": [1010, 640],
  "startOffset": 100,
  "css": ".proto-note,.fo,#fo,.nphow__model{display:none!important}body:not(.cart-open) .drawer{box-shadow:none}",
  "reset": {"localStorage": ["np-redesign-basket-v1", "np-recent-searches"]},
  "escapeOnJump": true,
  "closeOnJump": [".dr__head [data-close-cart]"],
  "steps": [
    {
      "label": "The menu",
      "page": "index.html",
      "start": 0,
      "actions": [
        {"wait": 500},
        {"hover": "[data-mega-link]", "ms": 900, "after": 1000},
        {"hover": "#mega .mega__list a", "nth": 2, "ms": 900, "after": 700},
        {"click": "#mega [data-pgdir='1']", "ms": 900, "after": 1300, "scroll": false},
        {"hover": "#mega .mega__flav", "nth": 4, "ms": 900, "after": 1200}
      ]
    },
    {
      "label": "Adding to the basket",
      "page": "collection-high-strength-nicotine-pouches.html",
      "start": 300,
      "actions": [
        {"wait": 400},
        {"click": ".pc[data-h=velo-tropical-mango-10mg] .pc__add", "ms": 900, "after": 1200},
        {"click": ".qa__packs [role=radio]", "nth": 2, "ms": 800, "after": 900, "scroll": false},
        {"click": "[data-qadd]", "ms": 800, "after": 2400, "scroll": false}
      ]
    },
    {
      "label": "Picking a strength",
      "page": "product.html?p=velo-bright-spearmint",
      "start": 0,
      "actions": [
        {"wait": 500},
        {"click": ".pdp__chips .mgc", "nth": 2, "ms": 900, "after": 900},
        {"click": ".pdp__chips .mgc", "nth": 3, "ms": 600, "after": 1200},
        {"click": ".packs .pack", "nth": 2, "ms": 900, "after": 1500}
      ]
    },
    {
      "label": "Nic Points",
      "page": "product.html?p=velo-bright-spearmint",
      "start": 0,
      "actions": [
        {"wait": 400},
        {"click": ".points-btn", "ms": 1000, "after": 1700},
        {"scrollTo": ".nptiers", "offset": 60, "ms": 1800, "after": 1800}
      ]
    }
  ],
  "mobile": {
    "label": "Quick-add on a phone",
    "page": "index.html",
    "width": 390,
    "touch": true,
    "start": 0,
    "actions": [
      {"wait": 1400},
      {"scrollTo": "#h-top", "offset": 80, "ms": 2400, "after": 900},
      {"tap": "#railTop .pc__add", "nth": 0, "after": 1500},
      {"tap": ".qa [role=radio]", "nth": 1, "after": 1100, "scroll": false},
      {"tap": "[data-qadd]", "after": 2600, "scroll": false}
    ]
  }
}
