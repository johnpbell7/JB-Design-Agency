{
  "name": "Nic Pouches",
  "viewport": {"width": 1440, "height": 900},
  "pace": 1,
  "start": [1010, 640],
  "startOffset": 100,
  "css": ".proto-note,.fo,#fo,.nphow__model{display:none!important}body:not(.cart-open) .drawer{box-shadow:none}",
  "reset": {"localStorage": ["np-redesign-basket-v1", "np-recent-searches"]},
  "escapeOnJump": true,
  "closeOnJump": [".dr__head [data-close-cart]"],
  "steps": [
    {
      "label": "Shop by strength",
      "page": "index.html",
      "start": 0,
      "actions": [
        {"wait": 1300},
        {"scrollTo": "#finder", "offset": 260, "ms": 2200, "after": 700},
        {"hover": ".fband", "nth": 0, "ms": 1100, "after": 700},
        {"hover": ".fband", "nth": 1, "ms": 800, "after": 600},
        {"click": ".fband[data-b=high]", "ms": 900, "after": 400}
      ]
    },
    {
      "label": "Strength on every card",
      "page": "collection-high-strength-nicotine-pouches.html",
      "start": 300,
      "actions": [
        {"wait": 1200},
        {"hover": ".pc[data-h=velo-bright-spearmint] .mgc", "nth": 0, "ms": 1100, "after": 500},
        {"click": ".pc[data-h=velo-bright-spearmint] .mgc", "nth": 1, "ms": 700, "after": 1300},
        {"click": ".pc[data-h=velo-bright-spearmint] .mgc", "nth": 3, "ms": 800, "after": 1600}
      ]
    },
    {
      "label": "Quick-add from the card",
      "page": "collection-high-strength-nicotine-pouches.html",
      "start": 300,
      "actions": [
        {"wait": 600},
        {"click": ".pc[data-h=velo-tropical-mango-10mg] .pc__add", "ms": 1100, "after": 1500},
        {"click": ".qa__packs [role=radio]", "nth": 1, "ms": 900, "after": 1000, "scroll": false},
        {"click": "[data-qadd]", "ms": 900, "after": 2200, "scroll": false},
        {"click": ".dr__head [data-close-cart]", "ms": 900, "after": 500, "scroll": false}
      ]
    },
    {
      "label": "A strength and a pack",
      "page": "product.html?p=velo-bright-spearmint",
      "start": 0,
      "actions": [
        {"wait": 1400},
        {"click": ".pdp__chips .mgc", "nth": 3, "ms": 1100, "after": 1400},
        {"scroll": 380, "ms": 1600, "after": 600},
        {"click": ".packs .pack", "nth": 2, "ms": 1000, "after": 1700}
      ]
    },
    {
      "label": "Mix & Match in the basket",
      "page": "product.html?p=velo-bright-spearmint",
      "start": 380,
      "actions": [
        {"wait": 500},
        {"click": ".packs .pack", "nth": 2, "ms": 900, "after": 700},
        {"click": ".buy .btn--lg", "ms": 1000, "after": 3200},
        {"click": ".dr__head [data-close-cart]", "ms": 900, "after": 400, "scroll": false}
      ]
    },
    {
      "label": "Nic Points",
      "page": "product.html?p=velo-bright-spearmint",
      "start": 0,
      "actions": [
        {"wait": 500},
        {"click": ".points-btn", "ms": 1200, "after": 300},
        {"wait": 1300},
        {"hover": ".npm", "nth": 0, "ms": 1100, "after": 900},
        {"hover": ".npm", "nth": 1, "ms": 800, "after": 900},
        {"hover": ".npm", "nth": 2, "ms": 800, "after": 1400}
      ]
    }
  ],
  "mobile": {
    "label": "Quick-add on a phone",
    "page": "index.html",
    "width": 390,
    "touch": true,
    "start": 0,
    "actions": [
      {"wait": 1400},
      {"scrollTo": "#h-top", "offset": 80, "ms": 2400, "after": 900},
      {"tap": "#railTop .pc__add", "nth": 0, "after": 1500},
      {"tap": ".qa [role=radio]", "nth": 1, "after": 1100, "scroll": false},
      {"tap": "[data-qadd]", "after": 2600, "scroll": false}
    ]
  }
}
