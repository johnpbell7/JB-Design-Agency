{
  "name": "Birdie Blooms",
  "viewport": { "width": 1440, "height": 900 },
  "pace": 1,
  "start": [960, 620],
  "startOffset": 70,
  "steps": [
    {
      "label": "The opening",
      "page": "index.html",
      "start": 0,
      "reload": true,
      "actions": [
        { "wait": 2600 },
        { "hover": ".hero-center .btn", "ms": 1000, "after": 1500 }
      ]
    },
    {
      "label": "The menu",
      "page": "index.html",
      "start": 0,
      "actions": [
        { "click": ".menu-btn", "ms": 900, "after": 1300 },
        { "hover": ".menu-link", "nth": 1, "ms": 800, "after": 700 },
        { "hover": ".menu-link", "nth": 3, "ms": 700, "after": 1500 },
        { "click": ".menu-close", "ms": 700, "after": 400 }
      ]
    },
    {
      "label": "The Birdie Card",
      "page": "index.html",
      "start": { "to": "#card", "offset": 760 },
      "reload": true,
      "actions": [
        { "scrollTo": "#card", "offset": 40, "ms": 1400, "after": 8600 }
      ]
    },
    {
      "label": "Season by season",
      "page": "seasons.html",
      "start": { "to": "#winter", "offset": 66 },
      "reload": true,
      "actions": [
        { "wait": 1600 },
        { "scrollTo": "#spring", "offset": 66, "ms": 1400, "after": 1100 },
        { "scrollTo": "#summer", "offset": 66, "ms": 1400, "after": 1100 },
        { "scrollTo": "#autumn", "offset": 66, "ms": 1400, "after": 1600 }
      ]
    }
  ],
  "mobile": {
    "page": "index.html",
    "start": 0,
    "width": 390,
    "touch": true,
    "pace": 1.1,
    "actions": [
      { "wait": 1800 },
      { "scroll": 760, "ms": 2200, "after": 900 },
      { "scrollTo": "#bouquets", "offset": 60, "ms": 1800, "after": 1100 },
      { "scroll": 620, "ms": 2000, "after": 900 },
      { "scrollTo": ".swatches", "offset": 200, "ms": 2000, "after": 1100 },
      { "scroll": 760, "ms": 2200, "after": 1200 }
    ]
  },
  "phones": [
    {
      "label": "Home",
      "page": "index.html",
      "start": 0,
      "touch": true,
      "actions": [
        { "wait": 1800 },
        { "scroll": 760, "ms": 2200, "after": 900 },
        { "scrollTo": "#bouquets", "offset": 60, "ms": 1800, "after": 1100 },
        { "scroll": 620, "ms": 2000, "after": 1200 }
      ]
    },
    {
      "label": "What’s in season",
      "page": "seasons.html",
      "start": 0,
      "touch": true,
      "actions": [
        { "wait": 1400 },
        { "scrollTo": "#winter", "offset": 60, "ms": 2000, "after": 1000 },
        { "scrollTo": "#spring", "offset": 60, "ms": 1900, "after": 1000 },
        { "scrollTo": "#summer", "offset": 60, "ms": 1900, "after": 1000 },
        { "scrollTo": "#autumn", "offset": 60, "ms": 1900, "after": 1200 }
      ]
    },
    {
      "label": "Enquire",
      "page": "shop.html",
      "start": { "to": "#bouquets", "offset": 60 },
      "touch": true,
      "actions": [
        { "wait": 1200 },
        { "scroll": 520, "ms": 1900, "after": 900 },
        { "tap": ".product a.btn", "nth": 1, "after": 600 },
        { "type": ["#c-name", "Sam"], "charMs": 140, "after": 900 },
        { "scrollTo": "#c-bouquet", "offset": 260, "ms": 1600, "after": 1400 }
      ]
    },
    {
      "label": "Weddings",
      "page": "weddings.html",
      "start": 0,
      "touch": true,
      "actions": [
        { "wait": 1600 },
        { "scroll": 700, "ms": 2200, "after": 1000 },
        { "scroll": 900, "ms": 2400, "after": 1000 },
        { "scrollTo": "#enquire", "offset": 80, "ms": 2200, "after": 1400 }
      ]
    }
  ]
}
