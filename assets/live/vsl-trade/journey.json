{
  "name": "VSL Trade",
  "viewport": { "width": 1440, "height": 900 },
  "pace": 1,
  "start": [960, 640],
  "startOffset": 100,
  "cursor": { "size": 22 },
  "reset": { "localStorage": ["vsl-consultation-v1", "vsl-consultation-sent-v1"] },
  "steps": [
    {
      "label": "One supplier, the whole shop",
      "page": "index.html",
      "start": 0,
      "actions": [
        { "wait": 1200 },
        { "move": ".ce-h1", "ms": 1200, "after": 1000 },
        { "hover": ".ce-hero-act .ce-btn", "ms": 1000, "after": 1800 },
        { "scrollTo": ".ce-wall", "offset": 60, "ms": 2600, "after": 3600, "visible": false }
      ]
    },
    {
      "label": "Two ranges, one account",
      "page": "index.html",
      "start": { "to": ".ce-cats", "offset": 150 },
      "actions": [
        { "wait": 700 },
        { "hover": ".ce-cat-b", "ms": 1200, "after": 1500, "visible": false },
        { "hover": ".ce-cat-a", "ms": 1000, "after": 1300, "visible": false },
        { "click": ".ce-cat-a", "ms": 400, "after": 300, "visible": false }
      ]
    },
    {
      "label": "Every vape category and brand",
      "page": "vape-nicotine.html",
      "start": { "to": ".vn-sqgrid", "offset": 150 },
      "actions": [
        { "wait": 900 },
        { "hover": ".vn-sq", "nth": 0, "ms": 1100, "after": 900, "visible": false },
        { "hover": ".vn-sq", "nth": 2, "ms": 900, "after": 900, "visible": false },
        { "hover": ".vn-sq", "nth": 4, "ms": 900, "after": 900, "visible": false },
        { "scrollTo": ".vn-brands", "offset": 170, "ms": 2200, "after": 700, "visible": false },
        { "hover": ".vn-brands-tiles img", "nth": 2, "ms": 1000, "after": 900, "visible": false },
        { "hover": ".vn-brands-tiles img", "nth": 7, "ms": 1000, "after": 1200, "visible": false },
        { "click": ".nav-links a", "text": "The App", "ms": 1300, "after": 300 }
      ]
    },
    {
      "label": "Order in the App, earn credit",
      "page": "app.html",
      "start": 0,
      "actions": [
        { "wait": 1400 },
        { "scrollTo": ".ap-slide.t1", "offset": 0, "ms": 1800, "after": 2400, "visible": false },
        { "scrollTo": ".ap-slide.t2", "offset": 0, "ms": 1900, "after": 2400, "visible": false },
        { "scrollTo": ".ap-slide.t3", "offset": 0, "ms": 1900, "after": 3000, "visible": false }
      ]
    },
    {
      "label": "A 55-page form, made simple",
      "page": "consultation.html",
      "start": 0,
      "reload": true,
      "actions": [
        { "wait": 1400 },
        { "type": ["#storeName", "Sam's Shop"], "ms": 1100, "after": 400 },
        { "type": ["#contactEmail", "sam@example.com"], "ms": 800, "after": 600 },
        { "click": "#cfStart button[type=submit]", "ms": 900, "after": 1600 },
        { "click": ".cf-opt", "nth": 1, "ms": 1000, "after": 700 },
        { "click": ".cf-opt", "text": "No", "ms": 900, "after": 900 },
        { "click": "[data-act=next]", "ms": 900, "after": 1800 }
      ]
    },
    {
      "label": "Register in a minute",
      "page": "register.html",
      "start": { "to": "#store-name", "offset": 300 },
      "actions": [
        { "wait": 900 },
        { "type": ["#store-name", "Sam's Shop"], "ms": 1100, "after": 500 },
        { "type": ["#contact-name", "Sam Patel"], "ms": 900, "after": 500 },
        { "type": ["#email", "sam@samsshop.co.uk"], "ms": 900, "after": 2400 }
      ]
    }
  ],
  "mobile": {
    "label": "Home and top brands",
    "page": "index.html",
    "width": 390,
    "touch": true,
    "start": 0,
    "actions": [
      { "wait": 1800 },
      { "scrollTo": ".ce-wall", "offset": 40, "ms": 3000, "after": 2400, "visible": false },
      { "scrollTo": ".ce-cats", "offset": 70, "ms": 3000, "after": 2400, "visible": false },
      { "scroll": 760, "ms": 3000, "after": 1800 }
    ]
  }
}
