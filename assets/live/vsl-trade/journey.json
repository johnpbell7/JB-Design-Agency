{
  "name": "VSL Trade",
  "viewport": {
    "width": 1440,
    "height": 900
  },
  "pace": 1,
  "start": [960, 640],
  "steps": [
    {
      "label": "One supplier, the whole shop",
      "page": "index.html",
      "start": 0,
      "actions": [
        { "wait": 1400 },
        { "hover": ".ce-hero-act .ce-btn", "ms": 1400, "after": 2200 }
      ]
    },
    {
      "label": "Two ranges, one account",
      "page": "index.html",
      "start": {
        "to": ".ce-cats",
        "offset": 150
      },
      "actions": [
        { "wait": 700 },
        { "hover": ".ce-cat-b", "ms": 1200, "after": 1500, "visible": false },
        { "hover": ".ce-cat-a", "ms": 1000, "after": 1300, "visible": false },
        { "click": ".ce-cat-a", "ms": 400, "after": 300, "visible": false }
      ]
    },
    {
      "label": "Every vape category",
      "page": "vape-nicotine.html",
      "start": {
        "to": ".vn-sqgrid",
        "offset": 150
      },
      "actions": [
        { "wait": 900 },
        { "hover": ".vn-sq", "nth": 0, "ms": 1100, "after": 1000, "visible": false },
        { "hover": ".vn-sq", "nth": 2, "ms": 900, "after": 1000, "visible": false },
        { "hover": ".vn-sq", "nth": 4, "ms": 900, "after": 1300, "visible": false }
      ]
    },
    {
      "label": "The brands they ask for",
      "page": "vape-nicotine.html",
      "start": {
        "to": ".vn-brands",
        "offset": 170
      },
      "actions": [
        { "wait": 800 },
        { "hover": ".vn-brands-tiles img", "nth": 2, "ms": 1100, "after": 1000, "visible": false },
        { "hover": ".vn-brands-tiles img", "nth": 7, "ms": 1000, "after": 1500, "visible": false },
        { "click": ".nav-links a", "text": "The App", "ms": 1300, "after": 300 }
      ]
    },
    {
      "label": "The App, from the till",
      "page": "app.html",
      "start": 0,
      "actions": [
        { "wait": 1500 },
        { "scrollTo": ".ap-slide.t1", "offset": 0, "ms": 1800, "after": 2600 },
        { "scrollTo": ".ap-slide.t2", "offset": 0, "ms": 1900, "after": 2400 },
        { "click": ".nav-right .btn-primary", "ms": 1300, "after": 300 }
      ]
    },
    {
      "label": "Register in a minute",
      "page": "register.html",
      "start": {
        "to": "#store-name",
        "offset": 300
      },
      "actions": [
        { "wait": 900 },
        { "type": [ "#store-name", "Sam's Shop" ], "ms": 1100, "after": 600 },
        { "type": [ "#contact-name", "Sam Patel" ], "ms": 900, "after": 2600 }
      ]
    }
  ],
  "mobile": {
    "label": "Vape & nicotine",
    "page": "index.html",
    "width": 390,
    "touch": true,
    "start": 0,
    "actions": [
      { "wait": 1200 },
      { "scroll": 620, "ms": 2000, "after": 600 },
      { "scrollTo": ".ce-cat-a", "offset": 160, "ms": 1800, "after": 800, "visible": false },
      { "tap": ".ce-cat-a", "after": 600, "visible": false },
      { "wait": 900 },
      { "scroll": 650, "ms": 2000, "after": 700 },
      { "scroll": 900, "ms": 2300, "after": 1400 }
    ]
  }
}
